# Estado e cache do Terraform (contem segredos — nunca commitar)
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# tfvars reais (podem conter senhas); apenas o .example vai ao git
*.tfvars
!*.tfvars.example

# kubeconfig e credenciais
kubeconfig
kubeconfig-*.yaml
.env
.env.local
*.pem

# overrides locais
override.tf
override.tf.json

# Planos do Terraform: carregam os valores das variaveis sensiveis
# (chave New Relic, entre outras) e nunca devem ser versionados.
tfplan
*.tfplan
*.bin
plan.txt
errored.tfstate

# IDE
.idea/
.vscode/
